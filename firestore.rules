rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    /**
     * @description This ruleset allows public read access to contact form submissions, but restricts write access to authenticated users.
     * Contact form submissions are stored in the `/contactform/{contactFormId}` collection.
     * @path /contactform/{contactFormId}
     * @allow (get, list) Public read access is allowed.
     * @allow (create) Allows creation if the 'id' field matches the document ID.
     * @allow (update, delete) Allows only authenticated users to update or delete existing submissions.
     * @deny (create) Denies creation if the 'id' field does not match the document ID.
     * @deny (update, delete) Denies unauthenticated users from updating or deleting submissions.
     * @principle Public read access, authenticated write access with ID validation.
     */
    match /contactform/{contactFormId} {
      // Allow anyone to read contact form submissions.
      allow get, list: if true;

      // Allow creation of contact form submissions if the ID matches the document ID and the user is signed in.
      allow create: if isSignedIn() && request.resource.data.id == contactFormId;

      // Allow updates and deletes only if the user is signed in and the document exists.
      allow update, delete: if isSignedIn() && resource != null;

    }

    // Define helper functions
    function isSignedIn() {
      return request.auth != null;
    }
  }
}