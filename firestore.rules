rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all reads and writes
    match /{document=**} {
      allow read, write: if false;
    }

    // Allow public creation of documents in the 'contactFormSubmissions' collection.
    // This allows the server-side API route (using the Admin SDK) to write new submissions.
    // No one can read, update, or delete submissions from the client-side.
    match /contactFormSubmissions/{submissionId} {
      allow create: if true;
      allow read, update, delete: if false;
    }
  }
}
