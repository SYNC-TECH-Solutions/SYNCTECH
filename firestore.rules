
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all reads and writes
    match /{document=**} {
      allow read, write: if false;
    }

    /**
     * @description Rules for the /contactFormSubmissions collection.
     * @path /contactFormSubmissions/{submissionId}
     * @allow create: Any user (authenticated or not) can create a new submission. This is necessary for a public contact form.
     * @deny read, update, delete: No client-side reads, updates, or deletes are allowed to protect the submitted data.
     * @principle Public write, admin-only access.
     */
    match /contactFormSubmissions/{submissionId} {
      allow create: if true;
      allow read, update, delete: if false;
    }
  }
}
