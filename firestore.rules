/**
 * @file Firestore Security Rules
 * @description This ruleset secures the 'contactform' collection.
 *
 * Core Philosophy:
 *   This ruleset enforces public read access while restricting write access to authenticated users.
 *   It is designed for prototyping and allows flexible data shapes.
 *
 * Data Structure:
 *   Data is stored in the /contactform/{contactFormId} collection.
 *   Each document represents a contact form submission.
 *
 * Key Security Decisions:
 *   - Public read access is granted to allow anyone to view contact form submissions.
 *   - Write access (create, update, delete) is denied for all users, including authenticated ones, as there is no concept of ownership or roles in the provided schema.
 *
 * Denormalization for Authorization: N/A (No ownership or roles)
 * Structural Segregation: N/A (Single collection for all submissions)
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows anyone to read contact form submissions, but restricts write access to authenticated users.
     * @path /contactform/{contactFormId}
     * @allow (get, list) - Any user can read contact form submissions.
     * @deny (create, update, delete) - No one can create, update, or delete contact form submissions.
     * @principle Public read, restricted write.
     */
    match /contactform/{contactFormId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }
  }
}